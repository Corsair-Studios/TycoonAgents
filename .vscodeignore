# Stray untracked working-tree dirs that must never ship (found leaking into
# 0.0.603's VSIX): Codex CLI hooks config, vitest JSON reporter output, and
# Windows PowerShell's module analysis cache.
.codex/**
.vitest/**
Microsoft/**

# TycoonAgents no longer bundles or installs Trashbyrd's Power Tools.
# Exclude the whole directory so it never ships, even if it's ever
# repopulated locally for dev/testing.
media/uefn-bridge/**

# Source parts for media/main.js (plan p21-t1) — the build step concatenates
# these into the committed, tracked media/main.js, which is what ships.
media/src/**

# Throwaway OpenCode hook-probe spike (plan p3-t1) — never ship.
standalone/spike/**
.opencode/**

# Local machine-managed OpenCode provider config — never ship (bug: was
# bundled into 0.0.576's VSIX). Root file only; unrelated nested
# opencode.json fixtures under test/ etc. are excluded already via test/**.
opencode.json

# Local routing snapshots that sometimes land under .claude/tycoon — already
# covered by .claude/** above, restated here for clarity/audit.
.claude/tycoon/routing*.json

# --- Routing generator scripts must ship in the VSIX ---------------------
# The VS Code Routing screen's Save (src/core/routingHostOps.ts ->
# saveRoutingProfile) spawns `node <extensionInstallPath>/scripts/<name>.mjs`
# at runtime, so these two scripts and the compiled modules they
# createRequire() at runtime (out/src/core/agentBackend.js -> modelAliases.js,
# routingProfile.js, localEnvStore.js) must be present in the packaged
# extension even though out/** and scripts/** are excluded above for
# everything else (the extension itself runs from bundled out/extension.js).
!scripts/apply-routing-profile.mjs
!scripts/generate-opencode-config.mjs
!scripts/generate-codex-config.mjs
!out/src/core/agentBackend.js
!out/src/core/modelAliases.js
!out/src/core/routingProfile.js
!out/src/host/vscode/packCatalog.js
!out/src/core/agentRelay.js
!out/src/core/localEnvStore.js

# p23-t11: panel.ts's INSTALL_CODEX_HOOKS/INSTALL_CODEX_DISPATCHER handlers
# require() these two compiled installer modules at runtime.
!out/src/providers/codex/installCodexHooks.js
!out/src/providers/codex/installCodexDispatcher.js

# Public-export tooling config (dev only; holds synthetic token fixtures)
public-export.allow
public-export.exclude
