# Scrub allowlist for scripts/export-public.mjs.
# One entry per line: <path-glob>:<substring of the matched text, or *>
# Example: test/foo.test.ts:D:\ACode

# Public commit-trailer address (role address, not personal)
docs/DISTRIBUTION.md:noreply@anthropic.com
scripts/release-local.mjs:noreply@anthropic.com
scripts/release.mjs:noreply@anthropic.com
test/releaseScript.test.ts:noreply@anthropic.com

