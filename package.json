{
  "name": "tycoonagents",
  "version": "0.0.19",
  "private": true,
  "description": "A builder/tycoon-style live visualization of AI coding-agent activity.",
  "displayName": "TycoonAgents",
  "publisher": "tycoonagents",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/src/host/vscode/extension.js",
  "activationEvents": ["onStartupFinished", "onCommand:tycoonagents.open", "onCommand:tycoonagents.demo"],
  "contributes": {
    "commands": [
      {
        "command": "tycoonagents.open",
        "title": "TycoonAgents: Open Panel"
      },
      {
        "command": "tycoonagents.demo",
        "title": "TycoonAgents: Run Demo"
      }
    ],
    "configuration": {
      "title": "TycoonAgents",
      "properties": {
        "tycoonagents.autoShow": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the live agent panel when a workspace opens."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Corsair-Studios/TycoonAgents"
  },
  "categories": ["Visualization", "Other"],
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
