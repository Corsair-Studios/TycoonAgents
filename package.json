{
  "name": "tycoonagents",
  "version": "0.0.208",
  "private": true,
  "description": "A builder/tycoon-style live visualization of AI coding-agent activity.",
  "displayName": "TycoonAgents",
  "publisher": "tycoonagents",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:tycoonagents.open",
    "onCommand:tycoonagents.demo",
    "onCommand:tycoonagents.upgradeInstalledThemes"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tycoonagents.open",
        "title": "TycoonAgents: Open Panel"
      },
      {
        "command": "tycoonagents.demo",
        "title": "TycoonAgents: Run Demo"
      },
      {
        "command": "tycoon.generateTheme",
        "title": "TycoonAgents: Generate Theme"
      },
      {
        "command": "tycoonagents.upgradeInstalledThemes",
        "title": "TycoonAgents: Upgrade Installed Themes"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "tycoon.theaterView",
          "name": "Theater"
        }
      ]
    },
    "configuration": {
      "title": "TycoonAgents",
      "properties": {
        "tycoonagents.autoShow": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the live agent panel when a workspace opens."
        },
        "tycoonagents.idleFreezeMinutes": {
          "type": "number",
          "default": 3,
          "description": "Freeze an agent's live time after this many minutes with no activity."
        },
        "tycoonagents.sanityCapMinutes": {
          "type": "number",
          "default": 15,
          "description": "Hard cap on any single active stretch (minutes)."
        },
        "tycoonagents.delegationWarnThreshold": {
          "type": "number",
          "default": 5,
          "description": "Warn in Delegation Health when the orchestrator's direct search count exceeds this in a session."
        },
        "tycoonagents.themeImageProvider": {
          "type": "string",
          "enum": [
            "openai",
            "gemini"
          ],
          "enumDescriptions": [
            "OpenAI GPT Image 2",
            "Google Gemini image generation"
          ],
          "default": "openai",
          "description": "AI provider used to plan and generate Theme Builder assets. OpenAI GPT Image 2 is the default."
        },
        "tycoonagents.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Fallback Google Gemini API key. Prefer the secure field in Themes > Theme Builder."
        },
        "tycoonagents.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "Fallback OpenAI API key. Prefer the secure field in Themes > Theme Builder."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Corsair-Studios/TycoonAgents"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build && npm run bundle:uefn && npm run bundle:designdoc && npm run bundle:themebuilder && npm run bundle:host && npm run check:paths && npm run check:webview && npm run test:compiled",
    "check:paths": "node scripts/check-no-absolute-paths.mjs",
    "check:webview": "node scripts/check-webview.mjs",
    "lint": "eslint .",
    "build": "tsc -p .",
    "build-ext": "tsc -p . && npm run bundle:host",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node --test \"out/test/**/*.test.js\"",
    "test:compiled": "node --test \"out/test/**/*.test.js\"",
    "bundle:uefn": "esbuild uefn-bridge/uefn-server.ts --bundle --platform=node --format=esm --target=node18 --outfile=media/uefn-bridge/uefn-server.mjs",
    "bundle:designdoc": "esbuild design-doc/design-doc-cli.ts --bundle --platform=node --format=esm --target=node18 --outfile=media/skills/design-doc/design-doc-cli.mjs",
    "bundle:themebuilder": "esbuild src/webview/themeBuilder.ts --bundle --outfile=media/theme-builder.js",
    "bundle:host": "esbuild src/host/vscode/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=out/extension.js",
    "package": "vsce package",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "docx": "^8.5.0",
    "esbuild": "^0.21.0",
    "eslint": "^10.6.0",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "mammoth": "^1.8.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.63.0",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "jimp": "^0.22.12"
  }
}
