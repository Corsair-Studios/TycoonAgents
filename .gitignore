# Dependencies
node_modules/

# Build output
out/
dist/
build/

# Packaged artifacts
*.vsix

# Bundled UEFN MCP server (built artifact; source is uefn-bridge/uefn-server.ts).
# Only the built .mjs is ignored — vendored files like uefn_bridge.py are tracked.
media/uefn-bridge/uefn-server.mjs

# Generated Codex hooks config with per-machine absolute paths (TycoonAgents writes it per machine)
.codex/
# Test-runner output cache
.vitest/
# Stray PowerShell ModuleAnalysisCache
Microsoft/

# Bundled design-doc CLI (built artifact; source is design-doc/design-doc-cli.ts).
# Only the built .mjs is ignored — SKILL.md in media/skills/design-doc/ is tracked.
media/skills/design-doc/design-doc-cli.mjs

# Compiled hook-runtime modules copied into hooks/ by scripts/copy-hook-runtime.mjs
# (built artifacts; source is src/core/agentBackend.ts and src/core/modelAliases.ts).
hooks/agentBackend.js
hooks/modelAliases.js
hooks/localEnvStore.js

# Environment / secrets
.env
.env.*

# Editor / OS
.DS_Store
Thumbs.db
.vscode-test/

# Local editor settings (machine-specific; not for distribution)
.vscode/settings.json

# Logs
*.log

# Local generated-image references used for scale calibration
scale-references/

# Local development tool artifacts
.claude/
CLAUDE.md
nul

# Work-in-progress staging area for assets (e.g. screenshots) dropped in by hand
# that are not ready to ship — must never be committed or packaged
.wip/

# Local diagnostic/config reports (may reference project-specific details; not for distribution)
AGENTS-CONFIG-REPORT.md

# Local project MCP config (machine-specific paths)
.mcp.json
design-doc/*.mp4

# Python bytecode caches (must never be tracked or shipped in the VSIX)
__pycache__/
*.pyc
*.pyo

# runtime-generated bridge self-sync status marker (never commit/ship)
media/uefn-bridge/bridge_sync_status.json
# runtime-generated moderation report written by the bridge (never commit/ship)
media/uefn-bridge/moderation_report.json
# runtime-generated moderation Licensed IP allowlist saved by the user (never commit/ship)
media/uefn-bridge/moderation_allowlist.json
# runtime-generated Verse tag inspector report written by the bridge (never commit/ship)
media/uefn-bridge/tag_inspect_report.json

# TycoonAgents runtime artifacts
.claude/session-journal.json

# OpenCode hook-probe spike output (runtime-generated, never commit)
standalone/spike/probe-log.jsonl
.opencode/plugin/probe-log.jsonl
.opencode/plugin/enforcement-probe-log.jsonl

# Holds a private invite link — never commit
design-doc/remotevm.txt

# Private operator reference — never commit
design-doc/grant.txt

# OpenCode routing-derived outputs (regenerated by
# scripts/generate-opencode-config.mjs and the standalone installer's
# install-hook --opencode from the local .claude/tycoon/routing.json
# profile; do not hand-edit or track — per-machine generated artifacts).
.opencode/agents/
.opencode/tycoon-routing.generated.json
.opencode/plugin/
/opencode.json

# Written when Codex runs the codex-hooks fixtures (notify.js, record.js)
test/fixtures/codex-hooks/raw-notify.jsonl
test/fixtures/codex-hooks/raw-hooks.jsonl

# Local scrub tokens for scripts/export-public.mjs (one per line)
.public-export.tokens
